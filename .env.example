# Formspree form ID used by the contact form (src/sections/Contact.jsx).
# 1. Create a free account at https://formspree.io
# 2. Create a new form and copy its ID from the endpoint URL:
#    https://formspree.io/f/<THIS_PART>
# 3. Copy this file to ".env" and paste the ID below.
VITE_FORMSPREE_FORM_ID=
